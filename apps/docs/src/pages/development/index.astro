---
import { getCollection, getEntry, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const documents = (await getCollection("development")).sort(
  (left, right) => left.data.order - right.data.order,
);
const entry = await getEntry("development", "index");

if (!entry) {
  throw new Error("Development index is missing.");
}

const { Content } = await render(entry);
---

<DocsLayout title="Development" description="開発フローと品質ルール">
  <article class="document">
    <p class="eyebrow">DEVELOPMENT</p>
    <Content />
    <a class="environment-guide-link" href="/development/environment-variables">
      <span>ENVIRONMENT</span>
      <strong>環境変数の設定ガイド</strong>
      <small>ログイン ID・パスワード、Neon、seed を図で確認する →</small>
    </a>
    <ul class="document-list">
      {
        documents
          .filter((document) => document.id !== "index")
          .map((document) => (
            <li>
              <a href={`/development/${document.id}`}>{document.data.title}</a>
              <span>{document.data.description}</span>
            </li>
          ))
      }
    </ul>
  </article>
</DocsLayout>
