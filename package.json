{
  "name": "expense-app",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "latest"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css,scss,html}": [
      "prettier --check --ignore-unknown"
    ],
    "apps/frontend/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --config apps/frontend/eslint.config.mjs --max-warnings=0"
    ],
    "apps/backend/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --config apps/backend/eslint.config.mjs --max-warnings=0"
    ]
  },
  "packageManager": "pnpm@9.7.0"
}
